# Copy this file to .env and fill in what you have.
# AshKai works with ZERO keys (DuckDuckGo + Wikipedia backends are free, no key required).
# Everything below is optional — it only adds more engines to the fusion blend.

PORT=8787

# Optional: adds Brave's independent index to the results blend.
# Get a free-tier key at https://brave.com/search/api/
BRAVE_API_KEY=

# Optional: adds Google's official Programmable Search (100 free queries/day)
# to the blend. This one is a real API, not a scrape — it won't get
# rate-limited or CAPTCHA-challenged the way DuckDuckGo scraping can.
# Setup (both free, ~5 minutes):
#   1. https://programmablesearchengine.google.com/ -> Add -> "Search the
#      entire web" -> create -> copy the Search engine ID (that's GOOGLE_CSE_ID)
#   2. https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#      -> Enable -> Credentials -> Create API key (that's GOOGLE_API_KEY)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional: lets the "Synthesize" button generate a one-paragraph AI summary
# of the top results, using your own Anthropic key. Nothing is sent to
# Anthropic unless the user explicitly clicks Synthesize on a specific query.
ANTHROPIC_API_KEY=
ASHKAI_SUMMARY_MODEL=claude-haiku-4-5-20251001

# Comma-separated origins allowed to call this API (your deployed frontend URL).
# Leave blank while developing locally to allow any origin.
ALLOWED_ORIGINS=
